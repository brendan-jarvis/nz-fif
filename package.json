{
  "name": "nz-fif",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source NZ foreign investment fund (FIF) calculator that runs entirely in your browser. Not tax advice.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build && bun scripts/finalize-dist.ts",
    "preview:worker": "wrangler dev --local --port 8787",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "scan": "bun scripts/scan-bundle.ts",
    "manifest": "bun scripts/build-manifest.ts",
    "headers:local": "bun scripts/check-headers-local.ts",
    "e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run scan",
    "verify-deploy": "bun scripts/verify-deploy.ts",
    "golden": "vitest run --config private/vitest.config.ts"
  },
  "dependencies": {
    "@nz-fif/core": "workspace:*",
    "decimal.js": "10.6.0",
    "preact": "10.29.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
