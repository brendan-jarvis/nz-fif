#!/usr/bin/env bash
# nz-fif data guard (PLAN §9). Blocks real exports and private data from commits.
#  1. *.csv / *.xlsx / *.xls / *.pdf only inside a fixtures/ folder.
#  2. Nothing under private/ (also git-ignored).
#  3. No file over 2 MB.
#  4. Staged additions must not contain any literal from private/denylist.txt
#     (built locally from the real exports by scripts/build-denylist.ts:
#     trade IDs, distinctive quantities and amounts, names, emails).
#  5. No NZ bank account numbers or personal-looking emails.
set -euo pipefail
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

while IFS= read -r f; do
  case "$f" in
    private/*) echo "data-guard: refusing to commit private/ file: $f"; fail=1 ;;
  esac
  case "$f" in
    *.csv|*.CSV|*.xlsx|*.XLSX|*.xls|*.pdf)
      case "/$f" in
        */fixtures/*) ;;
        *) echo "data-guard: spreadsheet/PDF outside fixtures/: $f"; fail=1 ;;
      esac ;;
  esac
  if [ -f "$f" ]; then
    size=$(wc -c < "$f")
    if [ "$size" -gt 2097152 ]; then echo "data-guard: $f is larger than 2 MB"; fail=1; fi
  fi
done <<< "$staged"

# Text content of staged additions (binary xlsx fixtures are unzipped to text first).
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git diff --cached -U0 --diff-filter=ACMR --no-color -- . ':(exclude).githooks/pre-commit' \
  | grep -E '^\+' | grep -vE '^\+\+\+ ' > "$tmp/added.txt" || true
while IFS= read -r f; do
  case "$f" in
    *.xlsx) if command -v unzip >/dev/null; then git show ":$f" > "$tmp/x.xlsx"; unzip -p "$tmp/x.xlsx" '*.xml' >> "$tmp/added.txt" 2>/dev/null || true; fi ;;
  esac
done <<< "$staged"

if [ -f private/denylist.txt ]; then
  hits=$(grep -n -F -f private/denylist.txt "$tmp/added.txt" | head -20 || true)
  if [ -n "$hits" ]; then
    echo "data-guard: staged content matches private/denylist.txt (real data?). First matches (line numbers in the staged diff):"
    echo "$hits" | cut -d: -f1 | sed "s/^/  diff line /"
    fail=1
  fi
else
  echo "data-guard: note: private/denylist.txt not found; only structural checks ran."
fi


if [ -f private/denylist-fixtures.txt ]; then
  fx=$(echo "$staged" | grep -E '(^|/)fixtures/' || true)
  if [ -n "$fx" ]; then
    : > "$tmp/fx.txt"
    while IFS= read -r f; do [ -f "$f" ] && git show ":$f" >> "$tmp/fx.txt" 2>/dev/null || true; done <<< "$fx"
    if grep -q -i -F -f private/denylist-fixtures.txt "$tmp/fx.txt"; then
      echo "data-guard: a fixture contains a name from private/denylist-fixtures.txt"; fail=1
    fi
  fi
fi

if grep -nE '\b[0-9]{2}-[0-9]{4}-[0-9]{7}-[0-9]{2,3}\b' "$tmp/added.txt" >/dev/null; then
  echo "data-guard: looks like an NZ bank account number in staged content"; fail=1
fi
emails=$(grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' "$tmp/added.txt" \
  | grep -vE '@(example\.(com|org|invalid)|users\.noreply\.github\.com|example\.invalid)$' | sort -u || true)
if [ -n "$emails" ]; then
  echo "data-guard: unexpected email address(es) in staged content: $emails"; fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "data-guard: commit blocked. Move real data to private/ (git-ignored) or anonymise it."
  exit 1
fi
